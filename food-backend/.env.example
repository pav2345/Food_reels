# Server
PORT=3000
FRONTEND_URL=http://localhost:5174

# PostgreSQL
DATABASE_URL=postgres://postgres:postgres@localhost:5432/food_reels?sslmode=disable

# JWT
JWT_SECRET=your_jwt_secret_here

# ImageKit (video storage)
